# Production build — unlike Dockerfile.frontend (which runs Vite's dev server
# for the local docker-compose bind-mount/HMR workflow), this compiles static
# assets and serves them from nginx. Used for the Kubernetes frontend Deployment.
FROM node:22-alpine AS build
WORKDIR /app
COPY 07_PLATFORM/frontend/package.json ./
RUN npm install
COPY 07_PLATFORM/frontend ./
# Vite inlines this into the built JS at build time, not read at container
# start — a relative path (not a hostname) so the same image works behind
# whatever origin actually serves it, since the gateway serves both this and
# /api/* from one external hostname.
ENV VITE_API_BASE_URL=/api
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY 08_INFRASTRUCTURE/docker/frontend-static.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
