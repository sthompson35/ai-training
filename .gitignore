.env
.env.*
!.env.example

# Local MCP server wiring (e.g. a Postgres MCP server pointed at this
# machine's own docker compose network/credentials) -- machine-specific,
# not something every clone of this repo should get for free.
.mcp.json
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
dist/
build/
coverage/

# TypeScript incremental-build cache -- its content changes on every `tsc -b`
# run (including ones an editor's TS server triggers in the background) and
# isn't reproducible across machines/environments, which previously caused
# false-positive manifest.json staleness failures in CI when this file's
# checked-in content didn't match whatever a fresh `tsc -b` produced.
*.tsbuildinfo
*.log
*.sqlite
*.db
.DS_Store
.vscode/
.idea/
.cache/
test-results/
playwright-report/
playwright/.cache/
07_PLATFORM/frontend/e2e/.auth/

# .NET build output (07_PLATFORM/dotnet-client) — compiled binaries, not
# source; some resource DLL paths under here are long enough to break a
# plain `git clone` on Windows without core.longpaths, on top of just being
# build artifacts that don't belong in version control.
bin/
obj/
*.dll
*.pdb
*.exe
