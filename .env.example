# AI Training Academy environment template
APP_NAME=AI Training Academy
APP_ENV=development
APP_VERSION=2.4.0
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
PHP_PORT=8081
GATEWAY_PORT=8080

AI_DEFAULT_ROUTE=server
AI_SERVER_PROVIDER=provider_placeholder
# Must match a model id actually loaded in your local inference server --
# check `curl $LOCAL_INFERENCE_BASE_URL/models` for what's available.
AI_SERVER_MODEL=model_placeholder
AI_LOCAL_ENABLED=true
AI_MAX_INPUT_CHARS_LOCAL=12000
AI_MAX_INPUT_CHARS_SERVER=200000
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_DAILY_COST_LIMIT_USD=25.00
# Illustrative placeholder rate, not a real provider price — used only to estimate
# a cost figure for server-side route decisions on the dashboard's cost tracker.
AI_SERVER_COST_PER_1K_CHARS_USD=0.002

# Where the "server" route's real execution (POST /v1/route with a prompt,
# or POST /v1/agents/{id}/execute) actually sends the request -- any
# OpenAI-compatible /chat/completions server (LM Studio, Ollama's OpenAI
# shim, vLLM, etc). host.docker.internal, not localhost: the API runs
# inside a container, and the inference server runs on the host machine.
LOCAL_INFERENCE_BASE_URL=http://host.docker.internal:1234/v1

AUDIT_LOG_ENABLED=true
REQUIRE_HUMAN_APPROVAL_TIER=2
POLICY_VERSION=2.0.0

# Never commit live credentials.
AI_PROVIDER_API_KEY=

POSTGRES_DB=academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://academy:academy@db:5432/academy

# Dev-only value. Generate a real secret (e.g. `openssl rand -hex 32`) before any real deployment.
AUTH_SECRET_KEY=dev-only-insecure-secret-change-me
AUTH_TOKEN_EXPIRE_MINUTES=1440

# Browser origins allowed to call the API directly (comma-separated). Needed because
# the frontend's own origin (FRONTEND_PORT) and the gateway's origin (GATEWAY_PORT)
# are different ports, hence different origins as far as the browser is concerned.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Per-process, in-memory sliding-window limits (per minute). Not shared across
# replicas — fine for this reference app's single-instance scale; a real
# multi-replica deployment would need a shared store (e.g. Redis) instead.
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
